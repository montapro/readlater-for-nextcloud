{
  "name": "readlater",
  "private": true,
  "author": "Markus Krause <hi@markuskrause.org> (https://markuskrause.org)",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "package:extension": "pnpm build && pnpm package:extension:dist && pnpm package:extension:source",
    "package:extension:dist": "cd apps/extension && node package.mjs",
    "package:extension:source": "rm -f readlater-source.zip && zip -qr readlater-source.zip . -x \"**/node_modules/*\" \"**/dist/*\" \"**/.git/*\" \"**/.turbo/*\" \"*.zip\""
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^5.0.0",
    "prettier": "^3.0.0",
    "@types/node": "^20.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
